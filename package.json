{
  "name": "double-sudoku",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build": "node scripts/build-mobile.mjs",
    "build:web": "node scripts/build-pages.mjs",
    "preview:mobile": "npm run build && node scripts/preview-mobile.mjs",
