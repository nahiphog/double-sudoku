    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.65.0"
  }
}
